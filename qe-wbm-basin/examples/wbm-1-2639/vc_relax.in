&CONTROL
  calculation = 'vc-relax'
  prefix = 'wbm_wbm-1-2639_relax'
  pseudo_dir = 'pseudos/sssp/upf'
  outdir = './tmp'
  verbosity = 'high'
  tprnfor = .true.
  tstress = .true.
  nstep = 99
  forc_conv_thr = 5.000e-04
  etot_conv_thr = 1.000e-05
/
&SYSTEM
  ibrav = 0
  nat = 6
  ntyp = 2
  ecutwfc = 38.2
  ecutrho = 305.8
  occupations = 'smearing'
  smearing = 'gaussian'
  degauss = 0.003674932217565499
/
&ELECTRONS
  conv_thr = 2.2e-05
  mixing_beta = 0.7
  electron_maxstep = 100
/
&IONS
  ion_dynamics = 'bfgs'
/
&CELL
  cell_dynamics = 'bfgs'
  press_conv_thr = 0.5
/
ATOMIC_SPECIES
  Al    26.9815 Al.pbe-n-kjpaw_psl.1.0.0.UPF
  S     32.0650 s_pbe_v1.4.uspp.F.UPF
