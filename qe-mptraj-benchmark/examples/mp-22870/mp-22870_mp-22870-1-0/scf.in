&CONTROL
  calculation = 'scf'
  prefix = 'mptraj_mp-22870_mp-22870-1-0'
  pseudo_dir = 'pseudos/sssp/upf'
  outdir = './tmp'
  verbosity = 'high'
  tprnfor = .true.
  tstress = .true.
/
&SYSTEM
  ibrav = 0
  nat = 4
  ntyp = 2
  ecutwfc = 50.0
  ecutrho = 400.0
  occupations = 'smearing'
  smearing = 'mv'
  degauss = 0.02
/
&ELECTRONS
  conv_thr = 1.0e-08
  mixing_beta = 0.7
  electron_maxstep = 300
/
