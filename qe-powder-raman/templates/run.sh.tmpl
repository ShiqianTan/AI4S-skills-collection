#!/usr/bin/env bash
# Generated by qe-powder-raman. Runs the Gamma-point powder-Raman chain:
#   pw.x scf -> ph.x (epsil + trans + lraman, Gamma) -> dynmat.x (TO) -> dynmat_lo*.in (optional LO)
set -euo pipefail
NP={np}
BIN="{bin_dir}"
MPI="{mpi_command}"
export OMP_NUM_THREADS={omp}
export ESPRESSO_PSEUDO="{pseudo_dir}"
cd "$(dirname "$0")"
rm -rf tmp ./*.dyn* dynmat_lo*.out dynmat_lo*.dat dynmat_table.dat
mkdir -p tmp
run_mpi() { if [ "$NP" -gt 1 ]; then "$MPI" -np "$NP" "$@"; else "$@"; fi; }
run_mpi "$BIN/pw.x"  -in scf.in  > scf.out
run_mpi "$BIN/ph.x"  -in ph.in   > ph.out
"$BIN/dynmat.x" -in dynmat.in > dynmat.out
for f in dynmat_lo*.in; do [ -f "$f" ] || continue; "$BIN/dynmat.x" -in "$f" > "${f%.in}.out"; done
echo "DONE"
